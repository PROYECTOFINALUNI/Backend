DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgresql://postgres:admin@localhost:5432/expenses
TEST_DATABASE_URL=postgresql://postgres:admin@localhost:5432/expenses_test
CORS_ALLOWED_ORIGINS=http://localhost:3000

# JWT bearer tokens authenticate the REST API (all roles).
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# Session/CSRF settings below only protect the Django Admin site at /admin/.
CSRF_TRUSTED_ORIGINS=http://localhost:3000
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SECURE=false
